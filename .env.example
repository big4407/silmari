# .env.example  → 각자 .env 로 복사해서 채움
# 모든 값은 core/config.py 의 Settings 필드와 매핑됩니다.
# 주석(#) 처리된 항목은 기본값이 있어 생략 가능하며, 바꾸고 싶을 때만 채우세요.

# ── 앱 / 환경 ──────────────────────────────────────────────
ENVIRONMENT=development
# APP_NAME=Silmari API

# ── DB (MySQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=silmari
DB_USER=root
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
# 로컬에서 SQLite 등으로 강제 지정할 때만 (지정 시 위 DB_* 무시):
# DATABASE_URL_OVERRIDE=sqlite:///./silmari.db

# ── JWT / 인증 ────────────────────────────────────────────
JWT_SECRET_KEY=please-generate-a-long-random-32+char-secret
# JWT_ALGORITHM=HS256
# JWT_ISSUER=silmari-auth
# JWT_AUDIENCE=silmari-api
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── bootstrap admin (개발용 최초 관리자) ──────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@silmari.com
BOOTSTRAP_ADMIN_NO_PASSWORD=false
# 운영 시: NO_PASSWORD=false 로 두고 아래에 비밀번호 지정
BOOTSTRAP_ADMIN_PASSWORD=1234

# ── 재난문자 API ──────────────────────────────────────────
DISASTER_API_BASE_URL=
DISASTER_API_PATH=
DISASTER_API_SERVICE_KEY=

# ── 외부 API 키 ───────────────────────────────────────────
SAFE182_API_KEY=
SAFE182_ESNTL_ID=
SAFETYDATA_SERVICE_KEY=
# SAFETYDATA_SERVICE_KEY 를 비우면 YOUR_API_KEY 값으로 폴백됩니다:
# YOUR_API_KEY=
# 엔드포인트 기본값이 있어 보통 생략 (바꿀 때만):
SAFETYDATA_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-00247

# ── 파일 경로 ─────────────────────────────────────────────
# 미지정 시 프로젝트 루트 기준 기본값 사용 (data/, models/yolo/):
#   upload_dir      = <root>/data/uploads
#   yolo_model_path = <root>/models/yolo/yolov8n.pt
#   cctv_data_dir   = <root>/data/CCTV
#   results_dir     = <root>/data/results
# 다른 위치를 쓰려면 아래 주석을 풀고 지정:
# UPLOAD_DIR=
# YOLO_MODEL_PATH=
# CCTV_DATA_DIR=
# RESULTS_DIR=
