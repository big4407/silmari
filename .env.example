# .env.example  → 각자 .env 로 복사해서 채움
# 모든 값은 backend/core/config.py 의 Settings 필드와 매핑됩니다.
# 주석(#) 처리된 항목은 기본값이 있어 생략 가능하며, 바꾸고 싶을 때만 채우세요.
# 이 파일 자체는 예시 템플릿일 뿐이며, 실제로 읽히는 파일은 프로젝트 루트의 .env 입니다
# (backend 폴더 안이 아니라 루트에서 uvicorn을 실행해야 함).

# ── 앱 / 환경 ──────────────────────────────────────────────
ENVIRONMENT=development
# APP_NAME=Silmari API

# ── DB (MySQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=silmari
DB_USER=root
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
# 로컬에서 SQLite 등으로 강제 지정할 때만 (지정 시 위 DB_* 무시):
# DATABASE_URL_OVERRIDE=sqlite:///./silmari.db

# ── JWT / 인증 ────────────────────────────────────────────
JWT_SECRET_KEY=please-generate-a-long-random-32+char-secret
# JWT_ALGORITHM=HS256
# JWT_ISSUER=silmari-auth
# JWT_AUDIENCE=silmari-api
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── bootstrap admin (개발용 최초 관리자) ──────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@silmari.com
BOOTSTRAP_ADMIN_NO_PASSWORD=false
# 운영 시: NO_PASSWORD=false 로 두고 아래에 비밀번호 지정
BOOTSTRAP_ADMIN_PASSWORD=1234
# NO_PASSWORD=true 로 쓰려면(개발 전용) ENVIRONMENT가 development/test여야 하고,
# BOOTSTRAP_ADMIN_PASSWORD는 반드시 비워둬야 합니다(둘 다 채우면 시작 시 에러).

# ── OpenAI (챗봇 슬롯 추출 + 안내문자 LLM 파싱) ───────────
# 없으면 챗봇 대화가 슬롯 추출 단계에서 실패하고, POST /message/parse도
# 실패합니다. .env.example에는 값 없이 키만 둡니다 — 직접 발급해서 채우세요.
OPENAI_API_KEY=

# ── 재난문자 API (행정안전부 긴급재난문자, DSSP-IF-00247) ───
# https://www.safetydata.go.kr/ 에서 API 키 발급 후 아래에 입력.
# 팀 공유: 키 값은 Slack/노션 등으로 전달하고, Git에는 올리지 않습니다.
#
# 필수 — 서비스키 (발급 내역의 "서비스키 값")
SAFETYDATA_SERVICE_KEY=
#
# 선택 — 기본 URL (보통 수정 불필요)
SAFETYDATA_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-00247
#
# 레거시 별칭 (SAFETYDATA_SERVICE_KEY 대신 쓸 때만)
# DISASTER_API_BASE_URL=https://www.safetydata.go.kr
# DISASTER_API_PATH=/V2/api/DSSP-IF-00247
# DISASTER_API_SERVICE_KEY=
#
# 발급받은 서비스키는 반드시 본인 PC의 공인 IP를 유저 IP로 등록해야
# 동작합니다(미등록 시 403/호출 실패). 값을 바꾼 뒤에는 백엔드를
# 재시작해야 반영됩니다(Settings가 시작 시 한 번만 캐시됨).

# ── 실종자 목록 API (safe182, 선택) ───────────────────────
SAFE182_API_KEY=
SAFE182_ESNTL_ID=

# ── FashionCLIP / HuggingFace 모델 로딩 ───────────────────
# 로컬에 이미 FashionCLIP 캐시가 있으면 기본(true)이 맞음 — huggingface_hub가
# 매번 "새 버전 있는지" 네트워크로 확인하는 것(HEAD 요청)을 건너뛰어, 접속이
# 느리거나 막힌 환경에서 로딩이 멈춘 것처럼 보이는 문제를 막습니다.
# 캐시가 전혀 없는 새 환경(최초 다운로드 필요)에서만 잠깐 false로 바꾸세요.
# HF_HUB_OFFLINE=true
#
# HF_HUB_OFFLINE=true여도 일부 코드 경로가 최소 1번은 HEAD 요청을 시도하는
# 알려진 버그가 있어(huggingface/transformers #43200), 그 요청 전용
# 타임아웃을 짧게 잡아 실패를 빠르게 만듭니다. 보통 안 건드려도 됩니다.
# HF_HUB_ETAG_TIMEOUT=1

# ── 검색 동작 ──────────────────────────────────────────────
# 검색 1건당 Chroma에서 가져오는 후보(매칭 결과) 최대 개수.
# 값이 크면 응답이 느려질 수 있어 필요시에만 조정하세요.
# SEARCH_RESULT_LIMIT=100

# ── 파일 경로 ─────────────────────────────────────────────
# 미지정 시 프로젝트 루트 기준 기본값 사용:
#   UPLOAD_DIR               = <root>/data/uploads
#   YOLO_MODEL_PATH           = <root>/data/yolo/yolov8n.pt
#   CCTV_DATA_DIR             = <root>/data/CCTV
#   RESULTS_DIR                = <root>/data/results
#   image_save_dir(코드 상수) = <root>/data/results/unique_persons
#   frame_dir(코드 상수)      = <root>/data/results/frames
#   detected_dir(코드 상수)   = <root>/data/results/detected
#   ADMINISTRATIVE_DONG_CSV    = <root>/data/raw/administrative_dong.csv
# 다른 위치를 쓰려면 아래 주석을 풀고 지정:
# UPLOAD_DIR=
# YOLO_MODEL_PATH=
# CCTV_DATA_DIR=
# RESULTS_DIR=
# ADMINISTRATIVE_DONG_CSV=

# ── ChromaDB (벡터 검색 저장소) ────────────────────────────
# 미지정 시 기본값: <root>/data/chroma
# MySQL과 별개의 로컬 파일 저장소입니다 — DB를 통째로 리셋(TRUNCATE 등)해도
# 이 폴더는 안 지워지므로, video 관련 테이블을 비웠다면 이 폴더도 같이
# 정리해야 합니다(안 그러면 video.id 재사용 시 엉뚱한 영상이 매칭되는 버그로
# 이어질 수 있음 — 자세한 내용은 ReadMe.md "알려진 이슈" 참고).
# CHROMA_DIR=
